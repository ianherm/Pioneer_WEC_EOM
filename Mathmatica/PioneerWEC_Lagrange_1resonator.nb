   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Get", " ", "the", " ", "true", " ", 
     RowBox[{"RHS", ":", 
      RowBox[{
      "handles", " ", "either", " ", "a", " ", "residual", " ", "expression", 
       " ", "or", " ", "an", " ", "Equal"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getRHS", "[", 
